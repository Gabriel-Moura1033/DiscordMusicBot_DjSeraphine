# --- Obrigatórias ---
# Developer Portal → Bot → Reset Token
DISCORD_TOKEN=
# Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=
# ID do servidor (modo desenvolvedor → botão direito no servidor → Copiar ID)
DISCORD_GUILD_ID=

# --- Limites ---
# Máximo de faixas importadas de uma playlist
MAX_PLAYLIST_SIZE=100
# Duração máxima por vídeo, em segundos (7200 = 2 h)
MAX_TRACK_DURATION_SECONDS=7200
# Tempo sozinho no canal ou com a fila vazia até desconectar, em segundos
IDLE_TIMEOUT_SECONDS=300
# Volume inicial (0-100)
DEFAULT_VOLUME=50

# --- Binários ---
# No container já vêm configurados (/opt/yt-dlp/yt-dlp e /usr/bin/ffmpeg); ajuste só fora do Docker.
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# Roda `yt-dlp --update-to stable` a cada start do container (falha não impede a subida)
YTDLP_AUTO_UPDATE=true

# --- Logs ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
