# --- Obrigatórias ---
# Developer Portal → Bot → Reset Token
DISCORD_TOKEN=
# Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=
# ID do servidor (modo desenvolvedor → botão direito no servidor → Copiar ID)
DISCORD_GUILD_ID=

# --- Limites ---
# Máximo de faixas importadas de uma playlist
MAX_PLAYLIST_SIZE=100
# Duração máxima por vídeo, em segundos (7200 = 2 h)
MAX_TRACK_DURATION_SECONDS=7200
# Tempo sozinho no canal ou com a fila vazia até desconectar, em segundos
IDLE_TIMEOUT_SECONDS=300
# Volume inicial (0-100)
DEFAULT_VOLUME=50
# Quantas faixas tocadas cada servidor lembra para o /previous (1–100).
HISTORY_SIZE=20

# --- Binários ---
# No container já vêm configurados (/opt/yt-dlp/yt-dlp e /usr/bin/ffmpeg); ajuste só fora do Docker.
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# Roda `yt-dlp --update-to stable` a cada start do container (falha não impede a subida)
YTDLP_AUTO_UPDATE=true

# --- Operação ---
# Arquivo de heartbeat lido pelo HEALTHCHECK do container (atualizado a cada 15 s com o gateway conectado).
# Deixe comentado para usar o padrão; definir vazio (HEARTBEAT_FILE=) desliga o heartbeat.
# HEARTBEAT_FILE=/tmp/dj-heartbeat
# Encerra o processo com erro se o gateway do Discord ficar desconectado por mais que isso (minutos);
# com restart: unless-stopped o container é reiniciado. 0 desliga.
GATEWAY_DOWN_EXIT_MINUTES=5

# --- Interface ---
# Sugestões de títulos ao digitar no /play (cada sugestão é uma busca no YouTube).
# Lido também no registro de comandos: ao mudar, rode o deploy de comandos de novo.
AUTOCOMPLETE_ENABLED=true
# Por quanto tempo uma busca do autocomplete fica em cache (segundos, 10–86400).
AUTOCOMPLETE_CACHE_TTL_SECONDS=600
# Mostra "Ouvindo <título>" no status do bot.
PRESENCE_ENABLED=true

# --- Logs ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
